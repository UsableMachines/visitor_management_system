# Visitor Management System — Environment Variables
SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///vms.db

# Session cookie
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SECURE=false

# Gunicorn
PORT=5000
WEB_CONCURRENCY=2
APP_GUNICORN_TIMEOUT=120

# Kindo AI Agent (required for AI risk analysis)
KINDO_API_TOKEN=
KINDO_AGENT_ID=

# Kindo agent polling timeout (seconds)
APP_AGENT_POLL_TIMEOUT_SEC=120
